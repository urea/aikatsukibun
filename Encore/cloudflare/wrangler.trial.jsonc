{
  // Local trial binding. A hosted trial uses its own DB ID and Worker configuration.
  "name": "aikatsu-encore-d1-trial",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "ENCORE_DB",
      "database_name": "aikatsu-encore-d1-trial",
      "database_id": "00000000-0000-4000-8000-000000000001"
    }
  ]
}
