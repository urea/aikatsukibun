# 通常版の現在の公開URLを確認して設定する。
VITE_RELATED_SITE_URL=
# 既存の公開URLを使いながら、配信先を分ける場合だけ設定する。
# ENCORE_ASSET_BASE_URL=https://your-static-host.example/
# VITE_ENCORE_PUBLICATION_URL=https://your-data-host.example/encore-publication.json
# R2の公開用バインドを設定したあと、サーバーと管理ツールの両方に指定する。
# ENCORE_D1_PUBLICATION_MIRROR=r2
# 共有動画API用。VITE_を付けず、サーバーだけで使用する。
DATABASE_URL=
# D1試験用。サーバー／管理ツールだけに設定する。
# ENCORE_VIDEO_STORE=d1
# ENCORE_D1_URL=http://127.0.0.1:18745
# ENCORE_D1_TOKEN=
# ENCORE_D1_ADMIN_TOKEN=
# ENCORE_RATE_LIMIT_SALT=
# ENCORE_D1_BLOB_PATHNAME=encore-publication-d1.json
